{
  "id": "sun-dev",
  "version": "0.1.2",
  "name": "Sun Development",
  "description": "Common editor, user, and cache configuration for Sun projects with an Ubuntu 26.04 development Dockerfile.",
  "documentationURL": "https://github.com/namo-robotics/sun_infra#readme",
  "publisher": "namo-robotics",
  "platforms": ["Sun", "C++", "Ubuntu"],
  "keywords": ["sun", "llvm", "cmake"],
  "options": {
    "name": {
      "type": "string",
      "description": "Development container display name",
      "default": "Sun Development"
    },
    "dockerfile": {
      "type": "string",
      "description": "Path to the project's Dockerfile, relative to .devcontainer",
      "default": "../Dockerfile"
    },
    "context": {
      "type": "string",
      "description": "Docker build context, relative to .devcontainer",
      "default": ".."
    }
  }
}

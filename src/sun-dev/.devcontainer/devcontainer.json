{
  "name": "${templateOption:name}",
  "build": {
    "context": "${templateOption:context}",
    "dockerfile": "${templateOption:dockerfile}"
  },
  "updateRemoteUserUID": true,
  "mounts": [
    "source=sun-${devcontainerId}-ccache,target=/home/ubuntu/.cache/ccache,type=volume",
    "source=${localEnv:HOME}/.codex,target=/home/ubuntu/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/ubuntu/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/ubuntu/.config/gh,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "CCACHE_DIR": "/home/ubuntu/.cache/ccache",
    "CCACHE_MAXSIZE": "10G"
  },
  "postCreateCommand": {
    "sun-cache": "bash .devcontainer/post-create.sh"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "namo-robotics.sun-language",
        "llvm-vs-code-extensions.vscode-clangd",
        "llvm-vs-code-extensions.lldb-dap",
        "ms-vscode.cmake-tools",
        "Anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "cmake.configureOnOpen": false,
        "[sun]": {
          "editor.defaultFormatter": "namo-robotics.sun-language",
          "editor.formatOnSave": true
        },
        "[cpp]": {
          "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
        }
      }
    }
  }
}
